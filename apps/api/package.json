{
  "name": "@mall/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "predev": "pnpm db:generate",
    "build": "nest build",
    "prebuild": "pnpm db:generate",
    "start": "node dist/main.js",
    "test": "jest",
    "test:e2e": "pnpm seed && jest --config ./test/jest-e2e.json --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretypecheck": "pnpm db:generate",
    "db:generate": "node scripts/prisma-runtime.mjs generate",
    "prisma:generate": "pnpm db:generate",
    "db:push": "node scripts/prisma-runtime.mjs push",
    "prisma:migrate": "node scripts/prisma-runtime.mjs migrate",
    "prisma:deploy": "node scripts/prisma-runtime.mjs deploy",
    "seed": "pnpm db:generate && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@mall/shared": "workspace:*",
    "@nestjs/common": "^11.2.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.0",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^11.2.0",
    "@nestjs/schedule": "6.1.3",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.19.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
