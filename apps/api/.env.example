# 默认：本地 SQLite（无需额外服务）
DATABASE_URL="file:./dev.db"

# PostgreSQL（本地 Docker：pnpm db:up，或云数据库）
# DATABASE_URL="postgresql://mall:mall@localhost:5433/mall_distribution?schema=public"

# MySQL 8.0+（腾讯云托管 MySQL）
# DATABASE_URL="mysql://user:password@host:3306/mall_distribution"

# 可选：URL 无法识别方言时强制指定（sqlite / mysql / postgresql）
# DB_PROVIDER=sqlite

PORT=3000
JWT_SECRET="dev-secret-change-me"
