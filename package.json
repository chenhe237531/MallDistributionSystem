{
  "name": "mall-distribution-system",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/**' dev",
    "dev:api": "pnpm --filter @mall/api dev",
    "dev:admin": "pnpm --filter @mall/admin dev",
    "dev:mini-b": "pnpm --filter @mall/mini-b dev:h5",
    "dev:mini-c": "pnpm --filter @mall/mini-c dev:h5",
    "build": "pnpm --filter @mall/shared build && pnpm -r --workspace-concurrency=1 --filter './apps/**' build",
    "test": "pnpm --filter @mall/shared test && pnpm --filter @mall/api test",
    "test:e2e": "pnpm --filter @mall/api test:e2e",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @mall/api prisma:migrate",
    "db:seed": "pnpm --filter @mall/api seed",
    "postinstall": "pnpm --filter @mall/shared build"
  },
  "devDependencies": {
    "webpack": "5.91.0"
  }
}
